# Create a bot with @BotFather and keep the token secret.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs. Leave empty only for local testing.
ALLOWED_TELEGRAM_USER_IDS=

DATABASE_PATH=data/portfolio_bot.sqlite3
MARKET_DATA_PROVIDER=yahoo
MARKET_CACHE_SECONDS=300
DEFAULT_TIMEZONE=America/Los_Angeles
DEFAULT_DAILY_BRIEF_TIME=07:30
LOG_LEVEL=INFO
